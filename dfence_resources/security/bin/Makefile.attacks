CC = gcc
CFLAGS = -static -O0
SRC = ../spectreV1.c
SRC2 = ../spectreV4.c
SRC3 = ../spectreV1_ext.c
SRC4 = ../spectreV4_ext.c

# Regla por defecto
all: spectrev1_  dfencev1  lfencev1  \
  	spectrev4_  lfencev4  dfencev4

spectrev1_: spectrev1

dfencev1: spectrev1_dfence

lfencev1: spectrev1_lfence

spectrev4_: spectrev4

lfencev4: spectrev4_lfence

dfencev4: spectrev4_dfence

# ----------- Compilaciones -----------

# --- Spectre V1
spectrev1:
	$(CC) $(CFLAGS) $(SRC) -o $@

spectrev1_lfence:
	$(CC) $(CFLAGS) -DLFENCE $(SRC) -o $@

spectrev1_dfence:
	$(CC) $(CFLAGS) -S $(SRC) -o spectreV1_dfence.s


# --- Spectre V4
spectrev4:
	$(CC) $(CFLAGS) $(SRC2) -o $@

spectrev4_lfence:
	$(CC) $(CFLAGS) -DLFENCE $(SRC2) -o $@


spectrev4_dfence:
	$(CC) $(CFLAGS) -S $(SRC2) -o spectreV4_dfence.s


# ----------- Limpiar -----------

clean:
	rm -f spectrev1  spectrev1_lfence  spectrev1_dfence  \
	      spectrev4  spectrev4_lfence  spectrev4_dfence
