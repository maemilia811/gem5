#!/usr/bin/env bash
# simulate: run the dfence/fence benchmarks in gem5 and collect the results.
#
#   simulate --impl <optimized|unoptimized|all> [--suite <all|embench|crypto>]
#            <ARCH> [POLICY] [INSTR]
#
#   IMPL     optimized | unoptimized | comma-separated list | all (both, one after the other)
#            selects the gem5 git branch to check out and build
#   SUITE    all (default) | embench | crypto
#            embench = only the binaries in benchmarks/POLICY/ARCH/embench-iot/bin
#   ARCH     x86 | arm | aarch64 | riscv, a comma-separated list, or "all"
#   POLICY   baseline | naive | smart | a comma-separated list | all
#            (optional, default: all = baseline, naive and smart)
#   INSTR    dfence | fence | lfence | a comma-separated list | all
#            (optional, default: all = dfence and fence)
#
# For each IMPL, gem5 is checked out and built ONCE (git checkout + scons
# build/ALL/gem5.opt -j<JOBS>), then for each ARCH, each POLICY, each INSTR and
# each benchmark it runs
#   build/ALL/gem5.opt configs/dfence/config_se_<ARCH>.py <BIN>
# and copies m5out/ to results/<IMPL>/<POLICY>/<ARCH>/<INSTR>/<BENCH>
# (or results/<IMPL>/baseline/<ARCH>/<BENCH> for baseline).
#
# Settings (environment variables, defaults in brackets):
#   GEM5_DIR            gem5 checkout                           [/dfence/gem5]
#   BENCH_ROOT          benchmarks directory                    [/dfence/benchmarks]
#   RESULTS_DIR         where results/ lives                    [$BENCH_ROOT/results]
#   JOBS                scons -j value                          [8]
#   BRANCH_OPTIMIZED    branch for --impl optimized             [dfence_opt]
#   BRANCH_UNOPTIMIZED  branch for --impl unoptimized           [dfence_unopt]
#   SUITE               default for --suite                     [all]
#
# Examples:
#   ./simulate --impl all --suite embench all            # whole Embench suite: both impls, all archs/policies/instrs
#   ./simulate --impl all --suite embench x86            # same, x86 only
#   ./simulate --impl optimized x86                      # everything for the optimized impl on x86
#   ./simulate --impl unoptimized x86 naive,smart dfence # naive + smart with dfence only

set -euo pipefail

GEM5_DIR=${GEM5_DIR:-/dfence/gem5}
BENCH_ROOT=${BENCH_ROOT:-/dfence/benchmarks}
RESULTS_DIR=${RESULTS_DIR:-$BENCH_ROOT/results}
JOBS=${JOBS:-8}
BRANCH_OPTIMIZED=${BRANCH_OPTIMIZED:-dfence_opt}
BRANCH_UNOPTIMIZED=${BRANCH_UNOPTIMIZED:-dfence_unopt}
SUITE=${SUITE:-all}

ALL_IMPLS="unoptimized optimized"
ALL_ARCHS="x86 arm aarch64 riscv"
ALL_POLICIES="baseline naive smart"
ALL_INSTRS="dfence fence"

# bench:dir  (the benchmark name and its directory under <POLICY>/<ARCH>/)
BENCHES="chacha20:chacha20 curve25519:curve gimli:gimli keccak:keccak \
poly1305:poly1305 mlkem:mlkem mldsa44:mldsa44 mldsa65:mldsa65 mldsa87:mldsa87 \
spectrev1:spectrev1"

EMBENCH_DIR="embench-iot"

# Path of a benchmark binary. Only the binary for the requested INSTR is
# accepted: no cross-fallback to another instruction or to the baseline binary.
bin_path() { # policy arch dir bench instr
    local policy="$1" arch="$2" dir="$3" bench="$4" instr="${5:-}"
    local base="$BENCH_ROOT/$policy/$arch/$dir/bin"

    if [ "$policy" = "baseline" ]; then
        echo "$base/${bench}_${arch}"
        return
    fi

    local candidate
    for candidate in \
        "$base/${bench}_${arch}_${instr}" \
        "$base/${bench}_${arch}_${instr}_insertion"; do
        if [ -x "$candidate" ]; then
            echo "$candidate"
            return
        fi
    done

    # Not found: return the expected path so the caller reports it as missing
    echo "$base/${bench}_${arch}_${instr}"
}

# Every Embench binary found in benchmarks/<policy>/<arch>/embench-iot/bin
embench_entries() { # policy arch instr
    local policy="$1" arch="$2" instr="${3:-}"
    local dir="$BENCH_ROOT/$policy/$arch/$EMBENCH_DIR/bin" f base bench
    [ -d "$dir" ] || return 0
    if [ "$policy" = "baseline" ]; then
        for f in "$dir"/*"_${arch}"; do
            [ -e "$f" ] || continue
            base="$(basename "$f")"
            echo "${base%_${arch}}:$EMBENCH_DIR"
        done
    else
        for f in "$dir"/*"_${arch}_${instr}" "$dir"/*"_${arch}_${instr}_insertion"; do
            [ -e "$f" ] || continue
            base="$(basename "$f")"
            bench="${base%_${arch}_${instr}_insertion}"
            bench="${bench%_${arch}_${instr}}"
            echo "${bench}:$EMBENCH_DIR"
        done | sort -u
    fi
}

# Benchmarks to run for (policy, arch, instr), according to SUITE
entries_for() { # policy arch instr
    local policy="$1" arch="$2" instr="${3:-}"
    case "$SUITE" in
        all|crypto) printf '%s\n' $BENCHES ;;
    esac
    case "$SUITE" in
        all|embench) embench_entries "$policy" "$arch" "$instr" ;;
    esac
}

usage() {
    sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//' >&2
}

die() { echo "Error: $*" >&2; exit 1; }

# expand_list <value> <all-list> <what>: "all" or a comma list -> validated words
expand_list() {
    local value="$1" all="$2" what="$3" out item
    if [ "$value" = "all" ]; then
        echo "$all"; return
    fi
    out="${value//,/ }"
    for item in $out; do
        case " $all " in
            *" $item "*) ;;
            *) die "unknown $what '$item' (known: $all)" ;;
        esac
    done
    echo "$out"
}

# ---------- arguments ----------
IMPL_ARG=""
pos=()
while [ $# -gt 0 ]; do
    case "$1" in
        --impl)    [ $# -ge 2 ] || die "--impl needs a value"; IMPL_ARG="$2"; shift 2 ;;
        --impl=*)  IMPL_ARG="${1#*=}"; shift ;;
        --suite)   [ $# -ge 2 ] || die "--suite needs a value"; SUITE="$2"; shift 2 ;;
        --suite=*) SUITE="${1#*=}"; shift ;;
        -h|--help) usage; exit 0 ;;
        -*) usage; die "unknown option: $1" ;;
        *) pos+=("$1"); shift ;;
    esac
done

[ -n "$IMPL_ARG" ] || { usage; die "--impl is required"; }
[ "${#pos[@]}" -ge 1 ] && [ "${#pos[@]}" -le 3 ] || { usage; die "expected: --impl IMPL ARCH [POLICY] [INSTR]"; }
ARCH_ARG="${pos[0]}"
POLICY_ARG="${pos[1]:-all}"
INSTR_ARG="${pos[2]:-all}"

case "$SUITE" in
    all|embench|crypto) ;;
    *) die "--suite must be all, embench or crypto (got '$SUITE')" ;;
esac

IMPLS="$(expand_list "$IMPL_ARG" "$ALL_IMPLS" implementation)"
ARCHS="$(expand_list "$ARCH_ARG" "$ALL_ARCHS" architecture)"
POLICIES="$(expand_list "$POLICY_ARG" "$ALL_POLICIES" policy)"

# Map lfence -> fence for argument expansion
INSTR_ARG_NORM="${INSTR_ARG//lfence/fence}"
INSTRS="$(expand_list "$INSTR_ARG_NORM" "$ALL_INSTRS" instruction)"

[ -d "$GEM5_DIR" ] || die "gem5 directory not found: $GEM5_DIR"
cd "$GEM5_DIR"

failed=()
ran=0

# run_one <tag> <config> <bin> <dest>
run_one() {
    local tag="$1" config="$2" bin="$3" dest="$4"
    if [ ! -x "$bin" ]; then
        echo "!! $tag: binary not found: $bin" >&2
        failed+=("$tag (no binary)")
        return 0
    fi

    echo "== $tag: simulating $bin"
    rm -rf m5out
    if ! build/ALL/gem5.opt "$config" "$bin"; then
        echo "!! $tag: gem5 failed" >&2
        failed+=("$tag (gem5 failed)")
        return 0
    fi

    if [ -e "$dest" ]; then
        echo "    replacing existing results in $dest"
        rm -rf "$dest"
    fi
    mkdir -p "$(dirname "$dest")"
    cp -r m5out "$dest"
    echo "    -> $dest"
    ran=$((ran + 1))
}

# ---------- one pass per implementation ----------
for IMPL in $IMPLS; do
    case "$IMPL" in
        optimized)   BRANCH="$BRANCH_OPTIMIZED" ;;
        unoptimized) BRANCH="$BRANCH_UNOPTIMIZED" ;;
    esac

    # checkout + build (once per implementation)
    echo "== IMPL=$IMPL SUITE=$SUITE ARCH=$ARCHS POLICY=$POLICIES INSTR=$INSTRS (branch: $BRANCH)"
    git checkout "$BRANCH"
    scons build/ALL/gem5.opt -j"$JOBS"

    for arch in $ARCHS; do
        config="configs/dfence/config_se_${arch}.py"
        if [ ! -f "$config" ]; then
            echo "!! $IMPL/$arch: $config not found, skipping architecture" >&2
            failed+=("$IMPL/$arch (no config)")
            continue
        fi

        for policy in $POLICIES; do
            if [ "$policy" = "baseline" ]; then
                for entry in $(entries_for "$policy" "$arch"); do
                    bench="${entry%%:*}"; dir="${entry#*:}"
                    bin="$(bin_path "$policy" "$arch" "$dir" "$bench")"
                    run_one "$IMPL/$arch/$policy/$bench" "$config" "$bin" \
                            "$RESULTS_DIR/$IMPL/$policy/$arch/$bench"
                done
            else
                for instr in $INSTRS; do
                    for entry in $(entries_for "$policy" "$arch" "$instr"); do
                        bench="${entry%%:*}"; dir="${entry#*:}"
                        bin="$(bin_path "$policy" "$arch" "$dir" "$bench" "$instr")"
                        run_one "$IMPL/$arch/$policy/$instr/$bench" "$config" "$bin" \
                                "$RESULTS_DIR/$IMPL/$policy/$arch/$instr/$bench"
                    done
                done
            fi
        done
    done
done

# ---------- summary ----------
echo "== done: $ran simulation(s) completed"
if [ "${#failed[@]}" -gt 0 ]; then
    echo "== ${#failed[@]} problem(s):" >&2
    printf '    %s\n' "${failed[@]}" >&2
    exit 1
fi
